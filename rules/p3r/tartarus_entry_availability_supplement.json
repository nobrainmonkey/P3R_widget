      ],
      "validity": "Observation applies only to this checkpoint night; never copied to future dates",
      "beforeEntryCheckRequired": true
    },
    {
      "id": "source_positive_future_night",
      "status": "conditional_source_witness",
      "guards": [
        "date matches positiveNightWitnesses or existing separately sourced January28 rule",
        "future evening not already spent/reserved",
        "normal story progression to this date explicitly assumed",
        "no explicit whole-slot or dungeon-only closure",
        "no known party/navigator/story restriction preventing departure",
        "known operational stage or observed block; cap remaining known and greater than0"
      ],
      "beforeEntryCheckRequired": true,
      "guaranteedEntry": false,
      "policy": "Prefer these source-positive dates over routine-night assumptions when suitable; witness does not require source social ranks or target floors"
    },
    {
      "id": "routine_future_evening",
      "status": "conditional_candidate_not_verified_available",
      "guards": [
        "date between April21 and January30 inclusive",
        "optional exploration unlocked or normal progression through its unlock explicitly assumed",
        "future evening has capacity under the existing disclosed calendar policy",
        "no explicit whole-slot lock or dungeon-only closure",
        "no known departure/navigator restriction",
        "operational stage identified or current stage supplied with valid date scope",
        "cap remaining known and greater than0"
      ],
      "assumptionId": "A.tartarus_routine_evening_entry_subject_to_check",
      "beforeEntryCheckRequired": true,
      "guaranteedEntry": false,
      "candidateGenerationEnabled": true,
      "use": "A planning reservation and before-entry checkpoint, not a theorem that every unlisted night is free",
      "failure": "If departure is unavailable, release reservation, record no visit and replan; keep stage cap and used-count knowledge"
    }
