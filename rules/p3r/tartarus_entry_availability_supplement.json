        "optional exploration unlocked",
        "known active stage or observed block reconciled",
        "cap remaining known and greater than0",
        "no unresolved observation/source conflict"
      ],
      "observationFields": [
        "tartarus.entryAvailableObserved=true",
        "tartarus.entryObservationDateOrdinal=currentDate",
