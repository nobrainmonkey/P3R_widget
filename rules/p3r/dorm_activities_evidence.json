  "gameEdition": "reload",
  "researchedDate": "2026-10-17",
  "scope": "18 repeatable evening dorm hangout tracks for all 9 teammates. These are separate from Link Episodes, Social Links, Koromaru walks and exam group study.",
  "capturePolicy": {
    "kind": "local_calendar_extraction_and_web_rendered_observations",
    "rawHtmlAdded": false,
    "officialSimplifiedChineseClaim": false,
    "description": "Existing cached aqiu calendar supplies exact dates and raw stat gains. Names use the existing official Simplified Chinese glossary; short action labels are editorial Chinese descriptions, not quoted in-game option text. New external evidence is summarized, not copied as a full article."
  },
