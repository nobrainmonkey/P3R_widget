  "sources": [
    {
      "id": "dorm_calendar_aqiu",
      "url": "https://aqiu384.github.io/megaten-database/p3r/social-events",
      "locator": "Calendar > Evening; four dorm columns and Walking == Brushing",
      "sourceType": "community_calendar",
      "snapshot": "rules/sources/aqiu_pages/social-events.html",
      "observations": [
        "Exact dated cells include story-event exceptions to the usual weekday schedule.",
        "Dorm activities open on 6/16. Aigis reading starts on 9/2.",
        "Shinjiro cooking has 8 opportunities from 9/3 through 10/3; gardening has 8 from 9/7 through 10/1. No track continues after 10/3.",
        "Cooking column Mit is tea; Ken is coffee. Walking column Brushing is the 18th dorm track and must not be confused with a Koromaru walk."
      ]
    },
    {
      "id": "dorm_rewards_aqiu",
      "url": "https://aqiu384.github.io/megaten-database/p3r/social-events#dorm-hangouts",
      "locator": "Hangouts > Dorm Hangouts > Availability / Learned Skills",
      "sourceType": "community_rules",
      "observations": [
        "DVD/reading activities give 2 raw social-stat points. This corresponds to one musical-note display in walkthroughs; do not import a displayed note as one raw point.",
        "Every character has two separate activity counters. One counter reaching 3 unlocks the base combat characteristic; both counters reaching 3 upgrade it. Three mixed activities in total are insufficient.",
        "Cooking/tea/coffee/brushing grant items and gardening improves harvests; none of those activities grants a social stat in this source.",
        "The source also claims some female teammates receive affinity, but that model conflicts with another source. This evidence intentionally models no Social Link affinity and never reuses generic visit/dialogue multipliers."
      ]
    },
    {
      "id": "dorm_gardening_prerequisite_steam",
      "url": "https://steamcommunity.com/sharedfiles/filedetails/?id=3152126765",
      "locator": "June Part 2 > Tuesday June 16 > Evening > Harvest Garden side note",
      "sourceType": "community_walkthrough",
      "observations": [
        "A crop must be planted to participate in a gardening dorm hangout. This is an availability prerequisite, separate from the actor date."
      ]
    },
    {
      "id": "dorm_gardening_preparation_neoseeker",
      "url": "https://www.neoseeker.com/persona-3-reload/walkthrough/September",
      "locator": "September 14 Evening Daily Action / September 24 and 29",
      "sourceType": "community_walkthrough",
      "observations": [
        "The 9/14 route plants a seedling and gardens with Shinjiro the same evening, so planting is a preparation step that does not consume the activity slot.",
        "The guide confirms gardening three times grants Shinjiro a characteristic, and completing cooking as well upgrades it."
      ]
    },
    {
      "id": "dorm_seed_prices_prima",
      "url": "https://primagames.com/gaming/persona-3-reload-all-gardening-seeds-and-where-to-get-them",
      "locator": "Where to get all gardening sprouts > Seed price table",
      "sourceType": "community_guide",
      "observations": [
        "Seedlings are paid inventory, with tomato and buff-potato seedlings priced at 700 yen. Gardening activity cost 0 does not mean preparation supplies are free.",
        "Only the garden prerequisite and basic seed cost are used; this source has different date claims for some later seedlings, which are not imported."
      ]
    }
  ],
  "milestones": {
    "counterUnit": "partner + activity category",
    "perTrackCap": 3,
    "baseCharacteristic": "At least one of a partner's two counters is 3.",
    "upgradedCharacteristic": "Both counters of that partner are 3.",
    "notEquivalentTo": "Total number of mixed hangouts, Persona awakening or a Link Episode rank.",
    "afterCap": "No further characteristic progress from repeating a completed track; stat and item rewards may still exist.",
    "recording": "Only completed/confirmed activity outcomes update real counters. Forecast rows are predictions, not achieved characteristics.",
    "sourceRefs": [
      "dorm_rewards_aqiu"
    ]
  },
  "moneySemantics": {
    "activityCost": 0,
    "timeCost": "one evening slot",
    "gardeningSupplyCost": "Requires planted growing crops. Buy/prepare seedlings separately, harvest mature crops and plant again before starting the hangout. Seed stock, growth and harvest are not simulated by this evidence.",
    "mustNotClaim": "All dorm activity setup is always free or available without preparation."
  },
  "affinityPolicy": {
    "modeledGain": 0,
    "reason": "Existing dorm-affinity evidence is unresolved; do not use ordinary Social Link hangout points or matching-Persona bonuses here.",
    "existingEvidence": "rules/p3r/affinity_model_evidence.json#dorm_affinity_not_generic"
  },
