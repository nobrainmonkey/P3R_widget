    "bonusEstimate": 0,
    "startingUnknownAffinityEstimate": 0,
    "safetyExtraMeetingsPerPositiveDeficit": 1,
    "safetyBufferEvidenceStatus": "product_model_choice_not_game_rule",
    "formula": "If readiness observed true or incoming threshold is known0:0 filler meetings. Else d=max(0, gate-modelAffinity). If d>0 reserve ceil(d/10)+1 ordinary meetings. Then rank-up event consumes a separate later slot.",
    "observedNotReadyOverridesEstimate": "If current readiness is observed false but numeric estimate reaches the gate, reserve at least1 ordinary meeting as safety and mark model mismatch; do not claim current readiness true",
    "knownThresholdConflict": "Use a separately declared conservative source-envelope scenario only where supported; preserve conflict. Do not call chosen threshold verified.",
    "unknownThreshold": "Use explicit budget scenario rather than mathematically proving readiness; unsupported target remains estimated/unknown, never impossible",
    "slotCost": 1,
    "rankDeltaDuringFiller": 0,
    "resetRule": "After completed projected rank event, discard pre-event surplus and replace scenario affinity by that scene’s modeled answer gain; no carry-through",
    "userFacingSummaryZh": "按较保守的会面次数预留时间；实际升阶更快时可提前调整",
    "notRequired": "No actual raw affinity input or confirmation after every planned filler meeting"
  },
  "dialogueScenarioPolicy": {
    "defaultPolicy": "declared_best_known_non_reversing_source_responses",
    "sourceMaximumIsAssumed": true,
    "noChineseOptionNumbersFromForeignOrdinals": true,
    "ChineseGuideReferences": "Show literal matched references where available; otherwise explain the recommended action without inventing exact game choices",
    "romance": "Respect explicit relationship preference/current flags. If unspecified, compare legal non-reversing branches or use shared conservative progress; do not silently set romance/friendship/eligibility as observed",
    "reversal": "Known reversed state needs repair model/observation; do not assume normal or count ordinary affinity while reversed",
    "partialEvents": "Moon9 and other branching events require full projected scene completion, not intermediate reversal state"
  },
