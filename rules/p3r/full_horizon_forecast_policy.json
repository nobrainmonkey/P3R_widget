  "checkedAtUtc": "2026-10-13",
  "purpose": "Produce an actionable remaining-calendar scenario without asking for hidden points or mandatory observation at every ordinary meeting",
  "mode": "conservative_scenario_estimate_not_guaranteed_lower_bound",
  "stateIsolation": {
    "observedLedger": "never mutated by projected actions",
    "verifiedLowerBounds": "remain independent; do not add estimated ordinary affinity to verified lower bounds",
    "scenarioState": "may propagate estimated affinity/readiness, expected costs/base income, unlock progress and chosen route under explicit assumptions",
    "reentry": "retain visible inputs; ask for changed outcomes/deviations only, not routine re-entry every2days"
  },
  "ordinaryMeetingModel": {
    "baseGainEstimate": 10,
    "sourceClaimStatus": "single_explicit_Reload_playthrough_not_independently_verified",
