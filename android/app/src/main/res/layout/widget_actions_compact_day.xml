<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/button_spec_row" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:baselineAligned="false" android:layoutDirection="ltr">
 <FrameLayout android:id="@+id/button_spec_current" android:layout_width="0dp" android:layout_weight="4" android:layout_height="40dp" android:background="@drawable/button_spec_flat_current_day" android:clickable="true" android:focusable="true" android:contentDescription="Current，返回最早未完成任务">
  <ImageView android:id="@+id/button_spec_return_icon" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="left|center_vertical" android:layout_marginLeft="2dp" android:layout_marginTop="1.5dp" android:src="@drawable/button_spec_return" android:duplicateParentState="true" android:importantForAccessibility="no" />
  <TextView android:id="@+id/button_spec_current_text" android:translationX="-0.5dp" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="7dp" android:layout_marginLeft="0dp" android:paddingLeft="13dp" android:paddingRight="13dp" android:layout_marginRight="3dp" android:text="Current" android:gravity="center" android:textColor="#344057" android:textSize="16sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textStyle="normal" android:includeFontPadding="false" android:maxLines="1" android:duplicateParentState="true" android:importantForAccessibility="no" />
 </FrameLayout>
 <FrameLayout android:layout_width="8dp" android:layout_height="40dp" />
 <FrameLayout android:id="@+id/button_spec_done" android:layout_width="0dp" android:layout_weight="6" android:layout_height="40dp" android:background="@drawable/button_spec_flat_done_day" android:clickable="true" android:focusable="true" android:contentDescription="Done，完成当前任务并进入下一项">
  <TextView android:id="@+id/button_spec_done_text" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="7dp" android:layout_marginLeft="0dp" android:layout_marginRight="3dp" android:text="Done" android:gravity="center" android:textColor="#101723" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textStyle="normal" android:includeFontPadding="false" android:maxLines="1" android:duplicateParentState="true" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/button_spec_check" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="right|center_vertical" android:layout_marginRight="10dp" android:layout_marginTop="1.5dp" android:src="@drawable/button_spec_check" android:duplicateParentState="true" android:importantForAccessibility="no" />
 </FrameLayout>
</LinearLayout>