<?xml version="1.0" encoding="utf-8"?>
<!-- Plan/guide widget card, regular size (about 4x2 cells and up). Shared by PlanWidget and the legacy
     PlannerWidget. XML defaults are a realistic day-palette sample so this file doubles as the picker
     preview; CardRenderer overwrites every text, image and palette resource at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_day"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_shafts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shafts_0" />

    <LinearLayout
        android:id="@+id/widget_watermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginRight="-2dp"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_watermark_tens"
            android:layout_width="wrap_content"
            android:layout_height="112dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_digit_2" />

        <ImageView
            android:id="@+id/widget_watermark_units"
            android:layout_width="wrap_content"
            android:layout_height="112dp"
            android:layout_marginLeft="-14dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_digit_2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/widget_plate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="left|center_vertical"
                android:background="@drawable/widget_plate_day"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingRight="10dp">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="上一项安排"
                    android:scaleType="center"
                    android:src="@drawable/widget_chevron_left" />

                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/p3r_numerals"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="10/22"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27dp"
                    android:textStyle="bold|italic" />

                <LinearLayout
                    android:id="@+id/widget_date_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:gravity="left"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_weekday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_weekday_day"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingLeft="7dp"
                        android:paddingTop="1dp"
                        android:paddingRight="7dp"
                        android:paddingBottom="1dp"
                        android:text="周四"
                        android:textColor="#FF0642B7"
                        android:textSize="10dp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_period_icon"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_moon_1" />

                        <TextView
                            android:id="@+id/widget_period_word"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="放学后"
                            android:textColor="#FFFFFFFF"
                            android:textSize="10.5dp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="下一项安排"
                    android:scaleType="center"
                    android:src="@drawable/widget_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|center_vertical"
                android:layout_marginRight="12dp"
                android:gravity="right"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_sees_mark"
                    android:layout_width="30dp"
                    android:layout_height="8.5dp"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="S.E.E.S."
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_sees_day" />

                <LinearLayout
                    android:id="@+id/widget_progress_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="今日"
                        android:textColor="#FF0A2A5C"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <include layout="@layout/widget_ticks" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_task_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget_task"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="19sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="left|bottom"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:text="皇帝 · 小田桐秀利"
                android:textColor="#FF0A2A5C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_dialogue_choices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:textColor="#FF0A2A5C"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/widget_meta_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/widget_tag_day"
                    android:fontFamily="@font/p3r_numerals"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="RANK 6→7"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableLeft="@drawable/widget_icon_pin_day"
                    android:drawablePadding="3dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="月光馆学园 3楼 走廊"
                    android:textColor="#FF0A2A5C"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_detail_cue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="✓ 已记录 · 再点撤销"
                android:textColor="#FF0A2A5C"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <include
            layout="@layout/widget_actions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp" />
    </LinearLayout>
</FrameLayout>
