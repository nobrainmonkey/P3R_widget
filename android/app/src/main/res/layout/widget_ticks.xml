<?xml version="1.0" encoding="utf-8"?>
<!-- Up to eight progress ticks (one per slot/task of the shown day). CardRenderer sets each tick's
     glyph, tint and visibility; unused ticks are GONE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ticks"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal">

    <ImageView android:id="@+id/widget_tick_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_done" />
    <ImageView android:id="@+id/widget_tick_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_current" />
    <ImageView android:id="@+id/widget_tick_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_pending" android:visibility="gone" />
    <ImageView android:id="@+id/widget_tick_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_pending" android:visibility="gone" />
    <ImageView android:id="@+id/widget_tick_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_pending" android:visibility="gone" />
    <ImageView android:id="@+id/widget_tick_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_pending" android:visibility="gone" />
    <ImageView android:id="@+id/widget_tick_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_pending" android:visibility="gone" />
    <ImageView android:id="@+id/widget_tick_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/widget_tick_pending" android:visibility="gone" />
</LinearLayout>
