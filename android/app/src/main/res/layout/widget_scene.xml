<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="true">
 <ViewFlipper android:id="@+id/widget_palette" android:layout_width="match_parent" android:layout_height="match_parent" android:animateFirstView="false" android:autoStart="false" >
  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget_day"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget_night"/>
 </ViewFlipper>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="40dp" android:layout_marginBottom="67dp" android:orientation="horizontal" android:importantForAccessibility="noHideDescendants">
  <FrameLayout android:layout_width="0dp" android:layout_weight="50" android:layout_height="match_parent"/>
  <ViewFlipper android:id="@+id/widget_art" android:layout_width="0dp" android:layout_weight="50" android:layout_height="match_parent" android:animateFirstView="false" android:autoStart="false" >
   <ImageView android:id="@+id/widget_art_day" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
   <ImageView android:id="@+id/widget_art_night" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
  </ViewFlipper>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="14dp" android:paddingRight="14dp">
  <FrameLayout android:layout_width="match_parent" android:layout_height="42dp">
   <LinearLayout android:id="@+id/widget_brand_wrap" android:layout_width="42dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P3R" android:textColor="#FFFFFF" android:textSize="21sp" android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:includeFontPadding="false"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RELOAD" android:textColor="#FFFFFF" android:textSize="5sp" android:letterSpacing="0.2" android:includeFontPadding="false"/>
   </LinearLayout>
   <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:orientation="horizontal">
    <TextView android:id="@+id/widget_prev" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textColor="#B3F3FF" android:textSize="23sp" android:contentDescription="上一个游戏日期"/>
    <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="May" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:includeFontPadding="false"/>
    <TextView android:id="@+id/widget_day_number" android:layout_width="wrap_content" android:minWidth="24dp" android:layout_height="25dp" android:layout_marginLeft="5dp" android:gravity="center" android:paddingLeft="3dp" android:paddingRight="3dp" android:rotation="-7" android:background="@drawable/bg_widget_numeral" android:text="2" android:textColor="#082D67" android:textSize="18sp" android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:includeFontPadding="false"/>
    <ImageView android:id="@+id/widget_period_icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginLeft="5dp" android:src="@drawable/widget_sun" android:contentDescription="白天"/>
    <TextView android:id="@+id/widget_next" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="#B3F3FF" android:textSize="23sp" android:contentDescription="下一个游戏日期"/>
   </LinearLayout>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="1dp" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_weight="55" android:layout_height="1dp" android:background="#60C1EAFF"/><FrameLayout android:layout_width="0dp" android:layout_weight="45" android:layout_height="1dp"/></LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="34dp" android:orientation="horizontal">
    <TextView android:id="@+id/widget_task" android:layout_width="0dp" android:layout_weight="57" android:layout_height="match_parent" android:gravity="center_vertical|start" android:text="下一项待办事项" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:ellipsize="end" android:maxLines="4" android:shadowColor="#80304470" android:shadowRadius="2" android:contentDescription="打开当前任务的完整攻略"/>
    <FrameLayout android:layout_width="0dp" android:layout_weight="43" android:layout_height="match_parent"/>
   </LinearLayout>
   <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="20dp" android:layout_gravity="bottom|left" android:layout_marginBottom="17dp" android:layout_marginRight="45dp" android:textColor="#C3DEF4" android:textSize="9sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="1"/>
   <TextView android:id="@+id/widget_progress" android:layout_width="45dp" android:layout_height="22dp" android:layout_gravity="bottom|left" android:gravity="left|center_vertical" android:text="0/3" android:textColor="#B3F3FF" android:textSize="12sp" android:textStyle="bold|italic" android:fontFamily="sans-serif-black" android:contentDescription="当前日期完成进度"/>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="1dp" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_weight="55" android:layout_height="1dp" android:background="#60C1EAFF"/><FrameLayout android:layout_width="0dp" android:layout_weight="45" android:layout_height="1dp"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
   <TextView android:id="@+id/widget_done" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/bg_widget_button_day" android:text="Done" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:maxLines="1" android:includeFontPadding="false"/>
   <TextView android:id="@+id/widget_next_todo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:gravity="center" android:background="@drawable/bg_widget_next_day" android:text="Next" android:textColor="#0A315E" android:textSize="14sp" android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:maxLines="1" android:includeFontPadding="false" android:contentDescription="在小组件内显示下一条未完成任务"/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>