<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp"
    android:background="@drawable/bg_widget_day">

    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent"
        android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">

        <LinearLayout android:id="@+id/widget_brand_wrap" android:layout_width="52dp" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="2dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/widget_brand_main" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="P3R" android:textColor="#B9F7FF" android:textSize="15sp"
                android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_brand_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RELOAD" android:textColor="#FFFFFF" android:textSize="8sp"
                android:fontFamily="sans-serif-condensed" android:textStyle="italic" android:letterSpacing="0.08"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/widget_prev" android:layout_width="20dp" android:layout_height="match_parent"
                android:gravity="center" android:text="‹" android:textColor="#B9F7FF" android:textSize="22sp"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                android:contentDescription="上一个游戏日期" />
            <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:fontFamily="sans-serif-black" android:textStyle="bold|italic"
                android:letterSpacing="0.01" android:text="May 2." android:textColor="#FFFFFF" android:textSize="18sp"
                android:includeFontPadding="false" android:contentDescription="打开这个日期" />
            <TextView android:id="@+id/widget_next" android:layout_width="20dp" android:layout_height="match_parent"
                android:gravity="center" android:text="›" android:textColor="#B9F7FF" android:textSize="22sp"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                android:contentDescription="下一个游戏日期" />
        </LinearLayout>

        <TextView android:id="@+id/widget_progress" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:gravity="center_vertical|end"
            android:text="0/3" android:fontFamily="sans-serif-black" android:textColor="#B9F7FF"
            android:textStyle="bold|italic" android:textSize="11sp" android:includeFontPadding="false"
            android:contentDescription="当前日期完成进度" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="6dp" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/widget_period" android:layout_width="26dp" android:layout_height="match_parent"
            android:background="@drawable/bg_widget_period_day" android:gravity="center" android:text="白&#10;天"
            android:fontFamily="sans-serif-black" android:textStyle="bold|italic"
            android:textColor="#08397A" android:textSize="11sp" android:lineSpacingExtra="1dp"
            android:includeFontPadding="false" android:maxLines="2" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/widget_task" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:gravity="center_vertical|start" android:text="下一项待办事项"
                android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="14sp"
                android:ellipsize="end" android:maxLines="3" android:includeFontPadding="false"
                android:contentDescription="打开当前任务的完整攻略" />
            <TextView android:id="@+id/widget_location" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone" android:maxLines="1"
                android:ellipsize="end" android:fontFamily="sans-serif-condensed" android:textStyle="italic"
                android:textColor="#DDF6FF" android:textSize="11sp" android:text="Location" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="33dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_done" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:background="@drawable/bg_widget_button_day"
            android:text="Done" android:textColor="#FFFFFF" android:gravity="center"
            android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:textSize="12sp"
            android:letterSpacing="0.03" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_next_todo" android:layout_marginStart="6dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:background="@drawable/bg_widget_next_day" android:text="Next"
            android:textColor="#08397A" android:gravity="center"
            android:fontFamily="sans-serif-black" android:textStyle="bold|italic" android:textSize="12sp"
            android:letterSpacing="0.03" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
            android:contentDescription="在小组件内显示下一条未完成任务" />
    </LinearLayout>
</LinearLayout>
