<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_surface_night" android:padding="6dp">
 <ImageView android:id="@+id/widget_motif" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitEnd" android:src="@drawable/widget_motif_chronicle_night" android:importantForAccessibility="no" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <FrameLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
   <LinearLayout android:id="@+id/widget_brand_wrap" android:layout_width="32dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:layout_gravity="left|center_vertical">
    <ImageView android:id="@+id/widget_official_logo" android:layout_width="26dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_official_p3r_logo" android:contentDescription="Persona 3 Reload" android:layout_gravity="left|center_vertical" /></LinearLayout>
   <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false" android:layout_gravity="center">
    <TextView android:id="@+id/widget_prev" android:layout_width="20dp" android:layout_height="match_parent" android:text="‹" android:gravity="center" android:textColor="#A8E7FF" android:textSize="20sp" android:contentDescription="上一个任务" />
   <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="May" android:textSize="21sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold|italic" android:textColor="#FFFFFF" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_day_number" android:layout_width="24dp" android:layout_height="29dp" android:layout_marginLeft="2dp" android:gravity="center" android:background="@drawable/widget_day_tile_night" android:text="2" android:textSize="23sp" android:textStyle="bold|italic" android:textColor="#082D67" android:includeFontPadding="false" />
    <ImageView android:id="@+id/widget_period_icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginLeft="2dp" android:src="@drawable/widget_sun" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_period_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="2dp" android:text="昼" android:textStyle="bold|italic" android:textSize="17sp" android:textColor="#FFFFFF" android:includeFontPadding="false" />
   <TextView android:id="@+id/widget_next" android:layout_width="20dp" android:layout_height="match_parent" android:text="›" android:gravity="center" android:textColor="#A8E7FF" android:textSize="20sp" android:contentDescription="下一个任务" />
  </LinearLayout>
   </FrameLayout></FrameLayout>
  <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#55D4F7FF" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/widget_task_area" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
   <TextView android:id="@+id/widget_task" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:text="查看今天的行动" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:gravity="left|center_vertical" android:includeFontPadding="false" android:maxLines="4" android:ellipsize="end" />
   <TextView android:id="@+id/widget_dialogue_choices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="#E5F8FF" android:includeFontPadding="false" android:lineSpacingExtra="1dp" android:visibility="gone" />
   <TextView android:id="@+id/widget_detail_cue" android:layout_width="match_parent" android:layout_height="12dp" android:gravity="center_vertical" android:layout_marginTop="2dp" android:text="（详见步骤）" android:textColor="#D2EFFF" android:textSize="9sp" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="23dp" android:orientation="horizontal" android:gravity="bottom" android:baselineAligned="false" android:paddingBottom="3dp">
   <TextView android:id="@+id/widget_location" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="bottom" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" android:textColor="#D2E9FF" android:textSize="9sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
   <LinearLayout android:layout_width="42dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="right">
    <TextView android:id="@+id/widget_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1/3" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● ○ ○" android:textColor="#D3ECFF" android:textSize="7sp" android:maxLines="1" android:includeFontPadding="false" />
   </LinearLayout>
  </LinearLayout>
  <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="3dp" android:background="#55D4F7FF" android:importantForAccessibility="no" />
  <include layout="@layout/widget_actions_compact_night" />
 </LinearLayout>
<ImageView android:id="@+id/widget_sees_mark" android:layout_width="22dp" android:layout_height="6.2dp" android:layout_gravity="top|right" android:layout_marginTop="10.9dp" android:layout_marginRight="0dp" android:src="@drawable/widget_sees_night" android:scaleType="fitCenter" android:contentDescription="S.E.E.S." /></FrameLayout>