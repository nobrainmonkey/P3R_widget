<?xml version="1.0" encoding="utf-8"?>
<!-- UI-module colour tokens layered on the shared p3r_* palette (docs/DESIGN_v3.md §7.3). -->
<resources>
    <!-- Card surfaces: translucent navy over the ocean background. -->
    <color name="ui_card">#E60B1E57</color>
    <color name="ui_card_raised">#F0102A6E</color>
    <color name="ui_card_sunken">#B3040D2E</color>
    <!-- Hero card gradient. -->
    <color name="ui_hero_start">#FF1650D0</color>
    <color name="ui_hero_end">#FF0A1C52</color>
    <!-- Overlays. -->
    <color name="ui_scrim">#B3020616</color>
    <color name="ui_sheet">#FF0A1A4C</color>
    <!-- Ink for unavailable / story-locked items (contrast about 5.9:1 on navy 900). -->
    <color name="ui_locked">#7F93C0</color>
    <!-- Cyan at low alpha for selection fills and light shafts. -->
    <color name="ui_cyan_soft">#333CE4FF</color>
    <color name="ui_cyan_faint">#1A3CE4FF</color>
    <!-- Page water near the surface (top of every page), after the game's menu blue. -->
    <color name="ui_sea_surface">#FF123C9C</color>
    <!-- Quiet text that still informs, straight on the water (record ages, past rows): 4.8:1 on the
         surface water, where p3r_ink_faint (2.9:1) is too weak for words. -->
    <color name="ui_ink_hint">#9DB6E6</color>
    <!-- Borderless glass panels: lighter top-left to deeper bottom-right, no outline. -->
    <color name="ui_glass_top">#E0102B73</color>
    <color name="ui_glass_bottom">#D9071648</color>
    <!-- Slanted summary bands and list hover. -->
    <color name="ui_band">#A6030A24</color>
    <!-- Light slash across hero panels. -->
    <color name="ui_slash">#1F7BEEFF</color>
    <!-- Sunday / holiday weekday plate (the game marks rest days in red). -->
    <color name="ui_holiday">#FFE0243C</color>
    <!-- Gold accent for attention: the return banner, notices and values marked "?". -->
    <color name="ui_gold">#FFD166</color>
</resources>
