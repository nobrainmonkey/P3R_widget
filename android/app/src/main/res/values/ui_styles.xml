<?xml version="1.0" encoding="utf-8"?>
<!-- UI-module styles. The manifest themes P3R.App / P3R.Sheet live in styles.xml (integrator-owned). -->
<resources>
    <!-- Bottom keypad dialogs (现金 / RANK): full width, transparent window, dimmed background. -->
    <style name="P3R.UiDialog" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:colorAccent">@color/p3r_cyan_400</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
