<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:usesCleartextTraffic="false"
    android:theme="@style/AppTheme"
    android:supportsRtl="true">

    <!-- v3 planner (launcher) -->
    <activity android:name=".v3.ui.HomeActivity" android:exported="true" android:launchMode="singleTask"
      android:theme="@style/P3R.App" android:windowSoftInputMode="adjustResize"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity android:name=".v3.ui.StateActivity" android:exported="false" android:theme="@style/P3R.App"
      android:windowSoftInputMode="adjustResize" />
    <activity android:name=".v3.ui.ResultActivity" android:exported="false" android:theme="@style/P3R.Sheet"
      android:excludeFromRecents="true" android:taskAffinity="app.p3r.planner.quick" android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize" />

    <!-- legacy fixed guide (unchanged behaviour) -->
    <activity android:name=".MainActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />

    <receiver android:name=".v3.widget.PlanWidget" android:exported="false" android:label="@string/plan_widget_label">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/plan_widget_info" />
    </receiver>
    <receiver android:name=".PlannerWidget" android:exported="false" android:label="@string/guide_widget_label">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/planner_widget_info" />
    </receiver>
    <receiver android:name=".WidgetUpgradeReceiver" android:exported="false">
      <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
    </receiver>
  </application>
</manifest>
